[user]
	email = alexboii@users.noreply.github.com

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true       # use n / N to jump between files
	line-numbers = true
	side-by-side = true

[merge]
	conflictStyle = zdiff3

# difftastic — structural (AST) diffs, on demand. Delta stays the default for
# `git diff`; these aliases swap in difft and override core.pager (delta would
# otherwise try to re-parse difft's output and mangle it).
[alias]
	dft = -c diff.external='difft --color always' -c core.pager='less -RFX' diff
	ds  = -c diff.external='difft --color always' -c core.pager='less -RFX' show --ext-diff
	dl  = -c diff.external='difft --color always' -c core.pager='less -RFX' log -p --ext-diff
