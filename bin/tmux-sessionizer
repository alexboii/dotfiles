#!/usr/bin/env bash
#
# tmux-sessionizer: pick a worktree (or pass one), open it as a tmux session
# with a 3-pane layout, and switch/attach.
#
# Layout:
#   +--------+--------+
#   | pane 1 |        |
#   +--------+ pane 3 |
#   | pane 2 |        |
#   +--------+--------+
#
# Usage:
#   tmux-sessionizer                # fzf-pick from ROOTS below
#   tmux-sessionizer /path/to/dir   # open the given directory directly
#
# Inspired by ThePrimeagen's tmux-sessionizer.

set -e

# Roots to scan for worktrees. Anything containing a `.git` (file or dir) within
# MAX_DEPTH levels is treated as a candidate. Missing paths (e.g. unmounted
# volumes) are silently skipped, and grouping dirs without `.git` are ignored.
# The find prunes the worktree itself once `.git` is found, so we never descend
# into node_modules / build outputs.
ROOTS=(
    "$HOME/wt"
    "/Volumes/PRO-G40"
    # "/Volumes/Modafinil"
)
MAX_DEPTH=4

candidates() {
    for root in "${ROOTS[@]}"; do
        [[ -d "$root" ]] || continue
        find "$root" -maxdepth "$MAX_DEPTH" -type d \
            -exec test -e {}/.git \; -print -prune 2>/dev/null
    done
}

if [[ $# -eq 1 ]]; then
    # Shortcut aliases. Add more `<name>) selected="<path>" ;;` lines as needed.
    case "$1" in
        main) selected="$HOME/housing_cloud/web" ;;
        *)    selected="$1" ;;
    esac
else
    selected=$(candidates | fzf)
fi

[[ -z "$selected" ]] && exit 0

SESSION="work"
window_name=$(basename "$selected" | tr ' .' '__')

build_panes() {
    local target="$1" dir="$2"
    tmux split-window -h -t "$target"   -c "$dir"
    tmux select-pane     -t "${target}.0"
    tmux split-window -v -t "$target"   -c "$dir"
    tmux select-pane     -t "${target}.0"
}

if tmux has-session -t "$SESSION" 2>/dev/null \
   && tmux list-windows -t "$SESSION" -F '#W' | grep -qx "$window_name"; then
    # Window already exists — just jump to it.
    tmux select-window -t "$SESSION:$window_name"

elif [[ -n "${TMUX:-}" ]] \
   && [[ "$(tmux display-message -p '#{session_name}')" == "$SESSION" ]] \
   && [[ "$(tmux display-message -p '#{window_panes}')" == "1" ]]; then
    # We're inside the work session, in a fresh 1-pane window (e.g. just made
    # via Cmd+T → "New tmux Tab"). Convert THIS window into the worktree
    # layout instead of opening another one.
    win_id=$(tmux display-message -p '#{window_id}')
    tmux rename-window -t "$win_id" "$window_name"
    printf -v esc '%q' "$selected"
    tmux send-keys -t "$win_id" "cd $esc && clear" Enter
    build_panes "$win_id" "$selected"

else
    # Create a fresh window (bootstrap the session if it doesn't exist yet).
    if ! tmux has-session -t "$SESSION" 2>/dev/null; then
        tmux new-session -ds "$SESSION" -n "$window_name" -c "$selected"
    else
        tmux new-window -t "$SESSION" -n "$window_name" -c "$selected"
    fi
    build_panes "$SESSION:$window_name" "$selected"
    tmux select-window -t "$SESSION:$window_name"
fi

if [[ -z "${TMUX:-}" ]]; then
    # In iTerm2, use -CC so each tmux window appears as an iTerm tab.
    if [[ "${TERM_PROGRAM:-}" == "iTerm.app" ]]; then
        exec tmux -CC attach -t "$SESSION"
    else
        exec tmux attach -t "$SESSION"
    fi
elif [[ "$(tmux display-message -p '#{session_name}')" != "$SESSION" ]]; then
    exec tmux switch-client -t "$SESSION:$window_name"
fi
