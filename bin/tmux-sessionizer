#!/usr/bin/env bash
#
# tmux-sessionizer: pick a worktree (or pass one), open it as a tmux session
# with a 3-pane layout, and switch/attach.
#
# Layout:
#   +--------+--------+
#   | pane 1 |        |
#   +--------+ pane 3 |
#   | pane 2 |        |
#   +--------+--------+
#
# Usage:
#   tmux-sessionizer                # fzf-pick from ROOTS below
#   tmux-sessionizer /path/to/dir   # open the given directory directly
#
# Inspired by ThePrimeagen's tmux-sessionizer.

set -e

# Worktree roots live in the shared `worktree-candidates` script so that `tw`
# (here) and `sw` (cmux, in ~/.zshrc) pick from the exact same list — edit the
# roots there in one place.

if [[ $# -eq 1 ]]; then
    # Shortcut aliases. Add more `<name>) selected="<path>" ;;` lines as needed.
    case "$1" in
        main) selected="$HOME/housing_cloud/web" ;;
        *)    selected="$1" ;;
    esac
else
    selected=$(worktree-candidates | fzf)
fi

[[ -z "$selected" ]] && exit 0

SESSION="work"
# Window name = shortened worktree path. Shows up in tmux status bar and as
# the iTerm2 tab title, so each tab clearly identifies its worktree.
# Replace $HOME → ~, then sanitize chars tmux doesn't like in names.
window_name="${selected/#$HOME/~}"
window_name=$(echo "$window_name" | tr ' .' '__')

build_panes() {
    local target="$1" dir="$2"
    # Remember the worktree root on this window so new splits (and any other
    # binding that wants it) can default to it instead of pane_current_path.
    tmux set-option -w -t "$target" "@worktree-root" "$dir"
    tmux split-window -h -t "$target"   -c "$dir"
    tmux select-pane     -t "${target}.0"
    tmux split-window -v -t "$target"   -c "$dir"
    tmux select-pane     -t "${target}.0"
}

if tmux has-session -t "$SESSION" 2>/dev/null \
   && tmux list-windows -t "$SESSION" -F '#W' | grep -qx "$window_name"; then
    # Window already exists — just jump to it.
    tmux select-window -t "$SESSION:$window_name"

elif [[ -n "${TMUX:-}" ]] \
   && [[ "$(tmux display-message -p '#{session_name}')" == "$SESSION" ]] \
   && [[ "$(tmux display-message -p '#{window_panes}')" == "1" ]]; then
    # We're inside the work session, in a fresh 1-pane window (e.g. just made
    # via Cmd+T → "New tmux Tab"). Convert THIS window into the worktree
    # layout instead of opening another one.
    win_id=$(tmux display-message -p '#{window_id}')
    tmux rename-window -t "$win_id" "$window_name"
    printf -v esc '%q' "$selected"
    tmux send-keys -t "$win_id" "cd $esc && clear" Enter
    build_panes "$win_id" "$selected"

else
    # Create a fresh window (bootstrap the session if it doesn't exist yet).
    if ! tmux has-session -t "$SESSION" 2>/dev/null; then
        tmux new-session -ds "$SESSION" -n "$window_name" -c "$selected"
    else
        tmux new-window -t "$SESSION" -n "$window_name" -c "$selected"
    fi
    build_panes "$SESSION:$window_name" "$selected"
    tmux select-window -t "$SESSION:$window_name"
fi

# New shells in this session land in their own window's worktree root via the
# per-window @worktree-root option (set in build_panes) — see the snippet in
# ~/.zshrc. No session-wide default dir is needed.

# Record the set of open worktrees so `twr` can rebuild the tabs after a
# tmux server restart. Always recorded (even during a `twr` rebuild) so the
# snapshot stays current and self-heals any worktree dirs that have vanished.
state_dir="$HOME/.local/state/tw"
mkdir -p "$state_dir"
tmux list-windows -t "$SESSION" -F '#{@worktree-root}' 2>/dev/null \
    | grep -v '^$' | sort -u > "$state_dir/worktrees"

# Rebuild mode: the window is set up; the caller (twr) attaches once at the end.
[[ -n "${TW_NO_ATTACH:-}" ]] && exit 0

if [[ -z "${TMUX:-}" ]]; then
    # In iTerm2, use -CC so each tmux window appears as an iTerm tab.
    if [[ "${TERM_PROGRAM:-}" == "iTerm.app" ]]; then
        exec tmux -CC attach -t "$SESSION"
    else
        exec tmux attach -t "$SESSION"
    fi
elif [[ "$(tmux display-message -p '#{session_name}')" != "$SESSION" ]]; then
    exec tmux switch-client -t "$SESSION:$window_name"
fi
