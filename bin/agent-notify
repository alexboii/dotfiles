#!/usr/bin/env bash
#
# Agent notification — plays a sound and flags the current tmux/iTerm tab so
# you can tell which session wants your attention. Shared by:
#   - Claude Code: ~/.claude/settings.json hooks (Notification + Stop)
#   - Codex:       ~/.codex/config.toml  notify = ["~/bin/agent-notify"]
# Symlinked to ~/bin by install.sh. Ignores any stdin/argv the agents pass.

sound="${AGENT_NOTIFY_SOUND:-$HOME/dotfiles/sounds/notify.mp3}"
[ -f "$sound" ] || sound="/System/Library/Sounds/Glass.aiff"   # fallback if the custom file is missing
afplay "$sound" >/dev/null 2>&1 &

# Ring this pane's bell → tmux/iTerm marks the tab as needing attention.
if [ -n "${TMUX_PANE:-}" ] && command -v tmux >/dev/null 2>&1; then
    tty=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_tty}' 2>/dev/null)
    [ -n "$tty" ] && printf '\a' > "$tty" 2>/dev/null
fi

exit 0
