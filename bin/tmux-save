#!/usr/bin/env bash
#
# Periodic tmux state save, invoked by the launchd agent
# com.dotfiles.tmux-save (every 60s). A timer-based backstop on top of the
# event hooks in .tmux.conf — and a replacement for tmux-continuum's
# status-line save, which doesn't fire under iTerm2's -CC integration.

# launchd runs with a minimal PATH; point at the usual Homebrew/system dirs.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

command -v tmux >/dev/null 2>&1 || exit 0
tmux has-session 2>/dev/null || exit 0   # no server / no sessions → nothing to save

"$HOME/.tmux/plugins/tmux-resurrect/scripts/save.sh" >/dev/null 2>&1

# Keep only the 100 most recent saves so the dir doesn't grow without bound.
dir="$HOME/.local/share/tmux/resurrect"
count=$(ls -1 "$dir"/tmux_resurrect_*.txt 2>/dev/null | wc -l | tr -d ' ')
if [ "${count:-0}" -gt 100 ]; then
    ls -t "$dir"/tmux_resurrect_*.txt | tail -n +101 | while read -r f; do rm -f "$f"; done
fi
